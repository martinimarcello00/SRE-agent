# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_PROJECT_ID=""
OPENAI_ADMIN_API_KEY=""
# Key pairs are used in this order; one over its daily limit is used again after 00:00 UTC (usage reset)
# Used when the primary key reaches MAX_DAILY_OPENAI_TOKEN_LIMIT (both required)
OPENAI_API_KEY_FALLBACK=""
OPENAI_ADMIN_API_KEY_FALLBACK=""
# Used when the first fallback key reaches MAX_DAILY_OPENAI_TOKEN_LIMIT (both required, optional pair)
OPENAI_API_KEY_FALLBACK_2=""
OPENAI_ADMIN_API_KEY_FALLBACK_2=""

# Telegram Notification (Optional)
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# LangSmith Tracing (Optional but Recommended)
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="SRE-agent"

# SRE Agent Configuration
# Budget for individual RCA workers
MAX_TOOL_CALLS="8"
# Number of tasks to execute in parallel
RCA_TASKS_PER_ITERATION="3"
# Starting service for trace analysis (e.g., 'frontend' or 'nginx')
TRACE_SERVICE_STARTING_POINT="frontend"
# Safety limit for daily token usage (primary and first fallback key)
MAX_DAILY_OPENAI_TOKEN_LIMIT="2000000"
# Safety limit for daily token usage of the second fallback key
MAX_DAILY_OPENAI_TOKEN_LIMIT_FALLBACK_2="3000000"

# Observability Tools & Cluster Access
PROMETHEUS_SERVER_URL="http://localhost:9090"
JAEGER_URL="http://localhost:16686"
TARGET_NAMESPACE="default"

# Neo4j Datagraph Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER=""
NEO4J_PASSWORD=""

# AIOpsLab Integration
# Directory where AIOpsLab is installed
AIOPSLAB_DIR="/path/to/AIOpsLab"
# Directory to store experiment results
RESULTS_PATH="Results"