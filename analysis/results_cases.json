{
  "cases": [
    {
      "id": "collection-ad-cpu",
      "application": "Astronomy Shop",
      "scenario": "Ad service high CPU",
      "selection": "F empty-symptom path and O positive detection without component localization",
      "limits": "Separate executions; no assertion that the injected CPU fault was observable in F's window.",
      "runs": [
        {
          "variant": "F",
          "checks": [
            {"pointer": "/symptoms", "equals": []},
            {"pointer": "/rca_tasks", "equals": []},
            {"pointer": "/rca_analyses_list", "equals": []},
            {"pointer": "/final_report/detection", "equals": false}
          ]
        },
        {
          "variant": "O",
          "checks": [
            {"pointer": "/triage_analysis/message_history/5/content", "contains": "ECONNREFUSED"},
            {"pointer": "/symptoms/1/affected_resource", "equals": "shipping"},
            {"pointer": "/rca_analyses_list/0/task/target_resource", "equals": "shipping"},
            {"pointer": "/final_report/detection", "equals": true},
            {"pointer": "/final_report/localization", "equals": null}
          ]
        }
      ]
    },
    {
      "id": "planning-network-delay",
      "application": "Hotel Reservation",
      "scenario": "Network delay",
      "selection": "F-only component match with different incoming symptoms and an unresolved mechanism",
      "limits": "Different symptom records prevent a fixed-input planning attribution; the report does not verify the declared delay mechanism.",
      "runs": [
        {
          "variant": "F",
          "checks": [
            {"pointer": "/symptoms/0/affected_resource", "contains": "user-"},
            {"pointer": "/rca_tasks/1/target_resource", "contains": "mongodb-user"},
            {"pointer": "/rca_analyses_list/0/diagnosis", "contains": "MongoDB"},
            {"pointer": "/final_report/localization/0", "contains": "user-"},
            {"pointer": "/final_report/root_cause", "contains": "transient networking/DNS/connectivity"},
            {"pointer": "/evaluation/rca_score", "equals": 1},
            {"pointer": "/evaluation/rca_motivation", "contains": "injected fixed 10s network latency"}
          ]
        },
        {
          "variant": "P",
          "checks": [
            {"pointer": "/symptoms/0/affected_resource", "equals": "frontend"},
            {"pointer": "/rca_tasks/0/target_resource", "equals": "frontend"},
            {"pointer": "/rca_analyses_list/0/task/target_resource", "equals": "frontend"},
            {"pointer": "/final_report/localization", "equals": ["service/frontend"]}
          ]
        }
      ]
    },
    {
      "id": "topology-cart",
      "application": "Astronomy Shop",
      "scenario": "Cart service failure",
      "selection": "N-only component match with an executed Worker graph query",
      "limits": "Incoming symptoms differ; the graph query returned no called services, not evidence that the dependency did not exist.",
      "runs": [
        {
          "variant": "F",
          "checks": [
            {"pointer": "/rca_analyses_list/0/task/target_resource", "equals": "frontend-proxy"},
            {"pointer": "/rca_analyses_list/1/task/target_resource", "equals": "frontend-proxy <-> frontend"},
            {"pointer": "/final_report/localization", "equals": ["frontend", "checkout"]}
          ]
        },
        {
          "variant": "N",
          "checks": [
            {"pointer": "/rca_analyses_list/0/task/target_resource", "equals": "cart"},
            {"pointer": "/rca_analyses_list/1/message_history/0/tool_calls/0/name", "equals": "get_services_used_by"},
            {"pointer": "/rca_analyses_list/1/message_history/1/content", "contains": "\"services_used\": []"},
            {"pointer": "/rca_analyses_list/1/message_history/2/tool_calls/0/name", "equals": "kubectl_describe"},
            {"pointer": "/rca_analyses_list/1/message_history/3/content", "contains": "valkey"},
            {"pointer": "/final_report/localization", "equals": ["cart"]}
          ]
        }
      ]
    },
    {
      "id": "workflow-ad-gc",
      "application": "Astronomy Shop",
      "scenario": "Ad service manual GC",
      "selection": "Sole additional Astronomy component match for F relative to M",
      "limits": "F matches ad but attributes its failure to memory exhaustion, not the declared repeated full-GC mechanism. Initial evidence and workflow both differ.",
      "runs": [
        {
          "variant": "F",
          "checks": [
            {"pointer": "/rca_analyses_list/0/task/target_resource", "contains": "ad-"},
            {"pointer": "/final_report/localization/0", "contains": "ad-"},
            {"pointer": "/final_report/root_cause", "contains": "OOMKilled"},
            {"pointer": "/evaluation/rca_score", "equals": 1},
            {"pointer": "/evaluation/rca_motivation", "contains": "full GC"}
          ]
        },
        {
          "variant": "M",
          "checks": [
            {"pointer": "/rca_analyses_list/0/message_history/17/content", "contains": "x509"},
            {"pointer": "/final_report/localization", "equals": ["kind-worker (kubelet)"]},
            {"pointer": "/final_report/root_cause", "contains": "TLS"}
          ]
        }
      ]
    }
  ]
}
